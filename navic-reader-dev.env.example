# Copy this file to navic-reader-dev.env or point scripts to an external env file.
# Do not commit real credentials.

BINDERY_OPDS_BASE_URL=https://bindery.example.invalid/opds
BINDERY_API_KEY=replace-me
BINDERY_API_KEY_HEADER=X-Api-Key
BINDERY_LANGUAGE_FILTER=eng

# Optional direct-reader launch. If NAVIC_READER_DEV_PUBLICATION_URL is omitted,
# scripts first derive it from BINDERY_OPDS_BASE_URL + BINDERY_TEST_RESOURCE_ID.
# If both are omitted, install-reader-dev.ps1 can discover the first OPDS ebook resource.
BINDERY_TEST_PUBLICATION_ID=example-book-id
BINDERY_TEST_RESOURCE_ID=books/example-book-id/resources/example.epub
NAVIC_READER_DEV_TITLE=Reader Dev
NAVIC_READER_DEV_KIND=ebook
NAVIC_READER_DEV_FORMAT=epub
# Optional 0..1 reader start fraction for resume/persistence validation.
NAVIC_READER_DEV_START_PROGRESS=
