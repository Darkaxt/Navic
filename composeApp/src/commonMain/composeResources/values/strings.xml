	<string name="subtitle_medley_mode">Automatically skip to the next queued song after the selected playback time. Off keeps full-track playback</string>
	<string name="subtitle_smart_rewind">After this point, Previous restarts the current song instead of jumping back</string>
	<string name="subtitle_pause_playback_on_volume_zero">Pause when Android media volume is muted, then resume if Navic paused it. Takes effect after playback restarts</string>
