# Copy this file to navic-release-login.env.
# Do not commit real credentials.

# Navidrome/Navic instance URL used by the public release package login form.
# Aliases accepted by scripts/adb-release-login.ps1:
# - NAVIC_INSTANCE_URL
# - NAVIDROME_BASE_URL
# - NAVIDROME_URL
NAVIC_INSTANCE_URL=https://navidrome.example.invalid

# Aliases accepted:
# - NAVIC_USERNAME
# - NAVIDROME_USERNAME
NAVIC_USERNAME=replace-me

# Aliases accepted:
# - NAVIC_PASSWORD
# - NAVIDROME_PASSWORD
NAVIC_PASSWORD=replace-me
